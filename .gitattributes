# Normalize all text files to LF in the repository. Windows checkouts keep LF in the
# working tree (avoids Biome CRLF churn under core.autocrlf=true).
* text=auto eol=lf

# Windows-native scripts may retain CRLF when present.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.db binary
