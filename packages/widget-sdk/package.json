      "types": "./dist/examples/demo-metrics/server.d.ts",
      "import": "./dist/examples/demo-metrics/server.js"
    },
    "./widgets/search": {
      "types": "./dist/widgets/search/index.d.ts",
      "import": "./dist/widgets/search/index.js"
    },
    "./widgets/clock": {
      "types": "./dist/widgets/clock/index.d.ts",
      "import": "./dist/widgets/clock/index.js"
    },
    "./widgets/bookmarks": {
      "types": "./dist/widgets/bookmarks/index.d.ts",
      "import": "./dist/widgets/bookmarks/index.js"
    },
    "./widgets/todo": {
      "types": "./dist/widgets/todo/index.d.ts",
      "import": "./dist/widgets/todo/index.js"
    },
    "./widgets/search/server": {
      "types": "./dist/widgets/search/server.d.ts",
      "import": "./dist/widgets/search/server.js"
    },
    "./widgets/clock/server": {
      "types": "./dist/widgets/clock/server.d.ts",
      "import": "./dist/widgets/clock/server.js"
    },
    "./widgets/bookmarks/server": {
      "types": "./dist/widgets/bookmarks/server.d.ts",
