NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_VERSION=1.0.0
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# Local default; production/Docker typically uses /data (see DEFAULT_DASHORA_DATA_DIR)
DASHORA_DATA_DIR=./data
# IANA timezone for the process (Compose sets TZ; image includes tzdata)
# TZ=UTC
# Origin printed in the first-run setup log line (defaults to CORS_ORIGIN)
# PUBLIC_BASE_URL=http://localhost:5173
# Secure cookie: auto | true | false (auto = Secure in production)
COOKIE_SECURE=auto
# Session lifetime (ms) and renewal threshold when remaining time falls below this
SESSION_TTL_MS=604800000
SESSION_RENEWAL_THRESHOLD_MS=86400000
# First-run setup token lifetime (ms). Default 24 hours.
SETUP_TOKEN_TTL_MS=86400000
# Login rate limiting
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# First-run setup completion rate limiting (protects the one-time setup token from brute-forcing)
SETUP_RATE_LIMIT_MAX=20
SETUP_RATE_LIMIT_WINDOW_MS=900000
# General API rate limit (abuse/DoS backstop applied to every route)
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
# HSTS max-age in seconds, sent only when the connection is treated as HTTPS. Default 180 days.
HSTS_MAX_AGE_SECONDS=15552000
# Global Fastify request body size limit in bytes (per-route overrides, e.g. backup import, may be higher)
MAX_BODY_BYTES=1000000
# 32-byte key as 64 hex characters for encrypting integration secrets (GitHub PATs, API secrets, ICS basic auth)
# SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Alternative to SECRETS_ENCRYPTION_KEY: path to a file containing the same 64-hex-character key,
# for Docker/Podman secret mounts. Mutually exclusive with SECRETS_ENCRYPTION_KEY.
# SECRETS_ENCRYPTION_KEY_FILE=/run/secrets/dashora_secrets_key
# Optional process-wide GitHub token used when a widget has no linked credential
# GITHUB_TOKEN=ghp_xxxxxxxx
# Markets widget provider keys (server-side only; never sent to the browser)
# COINGECKO_API_KEY=CG-xxxxxxxx
# FINNHUB_API_KEY=xxxxxxxx
# Reddit widget OAuth application credentials (server-side only)
# REDDIT_CLIENT_ID=xxxxxxxx
# REDDIT_CLIENT_SECRET=xxxxxxxx
# Twitch Helix application credentials (server-side only)
# TWITCH_CLIENT_ID=xxxxxxxx
# TWITCH_CLIENT_SECRET=xxxxxxxx
# Maximum accepted request body size for config-backup import uploads, in bytes
BACKUP_IMPORT_MAX_BYTES=8000000
