NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
# Local default; production/Docker typically uses /data (see DEFAULT_DASHORA_DATA_DIR)
DASHORA_DATA_DIR=./data
# Origin printed in the first-run setup log line (defaults to CORS_ORIGIN)
# PUBLIC_BASE_URL=http://localhost:5173
# Secure cookie: auto | true | false (auto = Secure in production)
COOKIE_SECURE=auto
# Session lifetime (ms) and renewal threshold when remaining time falls below this
SESSION_TTL_MS=604800000
SESSION_RENEWAL_THRESHOLD_MS=86400000
# First-run setup token lifetime (ms). Default 24 hours.
SETUP_TOKEN_TTL_MS=86400000
# Login rate limiting
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
