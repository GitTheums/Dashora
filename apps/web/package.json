    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.51.1",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.8.2",
